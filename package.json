{
  "name": "@setupless/drizzle",
  "version": "0.4.2",
  "description": "Small, typed helpers for defining Drizzle ORM schemas",
  "homepage": "https://github.com/Setupless/drizzle#readme",
  "bugs": {
    "url": "https://github.com/Setupless/drizzle/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Setupless/drizzle.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./pg": {
      "import": {
        "types": "./dist/pg/index.d.ts",
        "default": "./dist/pg/index.js"
      },
      "require": {
        "types": "./dist/cjs/pg/index.d.ts",
        "default": "./dist/cjs/pg/index.js"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite/index.d.ts",
        "default": "./dist/sqlite/index.js"
      },
      "require": {
        "types": "./dist/cjs/sqlite/index.d.ts",
        "default": "./dist/cjs/sqlite/index.js"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql/index.d.ts",
        "default": "./dist/mysql/index.js"
      },
      "require": {
        "types": "./dist/cjs/mysql/index.d.ts",
        "default": "./dist/cjs/mysql/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "fix": "bun run lint:fix && bun run format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepack": "bun run check",
    "prepublishOnly": "bun run test:package",
    "test": "bun test",
    "test:package": "bun scripts/test-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-orm": "^0.45.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.38.0 <0.46.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.0"
}
